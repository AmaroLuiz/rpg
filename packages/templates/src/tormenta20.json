{
  "id": "tormenta20",
  "name": "Tormenta20 (Jogo do Ano)",
  "version": 2,
  "description": "Template para Tormenta20, edição Jogo do Ano (atributos usados direto como bônus). Traz estrutura e números mecânicos; textos de raças, origens, poderes e magias ficam a cargo da mesa. Uma classe por personagem. Confira os números com o livro antes de usar.",
  "fields": [
    {
      "id": "nome",
      "label": "Nome",
      "type": "text"
    },
    {
      "id": "jogador",
      "label": "Jogador",
      "type": "text"
    },
    {
      "id": "raca",
      "label": "Raça",
      "type": "text"
    },
    {
      "id": "origem",
      "label": "Origem",
      "type": "text"
    },
    {
      "id": "classe",
      "label": "Classe",
      "type": "select",
      "catalog": "classes"
    },
    {
      "id": "divindade",
      "label": "Divindade",
      "type": "text"
    },
    {
      "id": "nivel",
      "label": "Nível",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 20
    },
    {
      "id": "for",
      "label": "Força",
      "type": "number",
      "default": 0,
      "min": -5
    },
    {
      "id": "des",
      "label": "Destreza",
      "type": "number",
      "default": 0,
      "min": -5
    },
    {
      "id": "con",
      "label": "Constituição",
      "type": "number",
      "default": 0,
      "min": -5
    },
    {
      "id": "int",
      "label": "Inteligência",
      "type": "number",
      "default": 0,
      "min": -5
    },
    {
      "id": "sab",
      "label": "Sabedoria",
      "type": "number",
      "default": 0,
      "min": -5
    },
    {
      "id": "car",
      "label": "Carisma",
      "type": "number",
      "default": 0,
      "min": -5
    },
    {
      "id": "meioNivel",
      "label": "Metade do nível",
      "type": "computed",
      "formula": "floor(@nivel / 2)"
    },
    {
      "id": "treino",
      "label": "Bônus de treinamento",
      "type": "computed",
      "formula": "lookup(@nivel, 1, 2, 7, 4, 15, 6)"
    },
    {
      "id": "pv",
      "label": "Pontos de Vida",
      "type": "resource",
      "color": "red",
      "min": -10,
      "allowTemp": true,
      "max": "@classe.pvInicial + @con + (@nivel - 1) * (@classe.pvPorNivel + @con)"
    },
    {
      "id": "pm",
      "label": "Pontos de Mana",
      "type": "resource",
      "color": "blue",
      "max": "@classe.pmPorNivel * @nivel"
    },
    {
      "id": "defesa",
      "label": "Defesa",
      "type": "computed",
      "formula": "10 + @des"
    },
    {
      "id": "deslocamento",
      "label": "Deslocamento (m)",
      "type": "number",
      "default": 9
    },
    {
      "id": "atributoMagia",
      "label": "Atributo de magia",
      "type": "select",
      "options": [
        {
          "value": "int",
          "label": "Inteligência"
        },
        {
          "value": "sab",
          "label": "Sabedoria"
        },
        {
          "value": "car",
          "label": "Carisma"
        }
      ],
      "default": "int"
    },
    {
      "id": "cdMagia",
      "label": "CD de magias",
      "type": "computed",
      "formula": "10 + @meioNivel + field(@atributoMagia)"
    },
    {
      "id": "carga",
      "label": "Carga (espaços)",
      "type": "computed",
      "formula": "sum(@itens.espacos * @itens.quantidade)"
    },
    {
      "id": "capacidade",
      "label": "Capacidade (espaços)",
      "type": "computed",
      "formula": "10 + 2 * @for"
    },
    {
      "id": "tibares",
      "label": "Tibares (T$)",
      "type": "number",
      "default": 0,
      "min": 0
    },
    {
      "id": "aparencia",
      "label": "Aparência",
      "type": "longtext"
    },
    {
      "id": "historia",
      "label": "História",
