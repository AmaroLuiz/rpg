      "label": "Inconsciente"
    }
  ],
  "rolls": [
    {
      "id": "pericia",
      "label": "{@self.nome}",
      "list": "pericias",
      "category": "pericias",
      "expr": "((@self.dados + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@self.dados + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@self.dados + @rolagem.dados + mod(\"dados_teste\"))d20kh1) + @self.bonus"
    },
    {
      "id": "teste_agi",
      "label": "Agilidade",
      "category": "atributos",
      "expr": "((@agi + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@agi + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@agi + @rolagem.dados + mod(\"dados_teste\"))d20kh1)"
    },
    {
      "id": "teste_for",
      "label": "Força",
      "category": "atributos",
      "expr": "((@for + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@for + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@for + @rolagem.dados + mod(\"dados_teste\"))d20kh1)"
    },
    {
      "id": "teste_int",
      "label": "Intelecto",
      "category": "atributos",
      "expr": "((@int + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@int + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@int + @rolagem.dados + mod(\"dados_teste\"))d20kh1)"
    },
    {
      "id": "teste_pre",
      "label": "Presença",
      "category": "atributos",
      "expr": "((@pre + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@pre + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@pre + @rolagem.dados + mod(\"dados_teste\"))d20kh1)"
    },
    {
      "id": "teste_vig",
      "label": "Vigor",
      "category": "atributos",
      "expr": "((@vig + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@vig + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@vig + @rolagem.dados + mod(\"dados_teste\"))d20kh1)"
    },
    {
      "id": "iniciativa",
      "label": "Iniciativa",
      "category": "combate",
      "expr": "((@pericias.iniciativa.dados + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@pericias.iniciativa.dados + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@pericias.iniciativa.dados + @rolagem.dados + mod(\"dados_teste\"))d20kh1) + @pericias.iniciativa.bonus"
    },
    {
      "id": "ataque",
      "label": "Ataque: {@self.nome}",
      "list": "ataques",
      "category": "combate",
      "expr": "((@self.dados + @rolagem.dados + mod(\"dados_teste\")) <= 0 ? (2 - (@self.dados + @rolagem.dados + mod(\"dados_teste\")))d20kl1 : (@self.dados + @rolagem.dados + mod(\"dados_teste\"))d20kh1) + @self.bonus"
    },
    {
      "id": "dano",
      "label": "Dano: {@self.nome}",
      "list": "ataques",
      "category": "combate",
      "expr": "roll(@self.dano)"
    }
  ],
