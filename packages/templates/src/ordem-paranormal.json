  "validations": [
    {
      "id": "atributos_criacao_max",
      "when": "@nex == 5 && max(@agi, @for, @int, @pre, @vig) > 3",
      "message": "Na criação (NEX 5%), nenhum atributo passa de 3."
    },
    {
      "id": "atributos_criacao_soma",
      "when": "@nex == 5 && @agi + @for + @int + @pre + @vig != 9",
      "message": "Na criação, os atributos somam 9 (todos em 1 mais 4 pontos); agora somam {@agi + @for + @int + @pre + @vig}."
    },
    {
      "id": "veterano_cedo",
      "when": "@nex < 35 && count(@pericias.grau, 10) + count(@pericias.grau, 15) > 0",
      "message": "Grau veterano só a partir de NEX 35%."
    },
    {
      "id": "expert_cedo",
      "when": "@nex < 70 && count(@pericias.grau, 15) > 0",
      "message": "Grau expert só a partir de NEX 70%."
    },
    {
      "id": "sobrecarga",
      "when": "@carga > @capacidade",
      "message": "Sobrecarregado: {@carga} de {@capacidade} espaços."
    },
    {
      "id": "sem_classe",
      "when": "@classe == null",
      "message": "Escolha uma classe para calcular PV, PE e Sanidade.",
      "level": "info"
    }
  ],
