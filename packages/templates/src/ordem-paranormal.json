{
  "id": "ordem_paranormal",
  "name": "Ordem Paranormal",
  "version": 4,
  "description": "Template para Ordem Paranormal RPG. Traz estrutura e números mecânicos; rituais, poderes, origens e equipamentos podem ser adicionados do compêndio (com resumos e a página do livro). Confira os números com o livro antes de usar.",
  "fields": [
    {
      "id": "nome",
      "label": "Nome",
      "type": "text"
    },
    {
      "id": "jogador",
      "label": "Jogador",
      "type": "text"
    },
    {
      "id": "conceito",
      "label": "Conceito",
      "type": "text"
    },
    {
      "id": "origem",
      "label": "Origem",
      "type": "text"
    },
    {
      "id": "classe",
      "label": "Classe",
      "type": "select",
      "catalog": "classes"
    },
    {
      "id": "trilha",
      "label": "Trilha",
      "type": "text"
    },
    {
      "id": "nex",
      "label": "NEX (%)",
      "type": "number",
      "default": 5,
      "min": 5,
      "max": 99,
      "step": 5
    },
    {
      "id": "nivelNex",
      "label": "Nível de exposição",
      "type": "computed",
      "formula": "@nex >= 99 ? 20 : floor(@nex / 5)"
    },
    {
      "id": "patente",
      "label": "Patente",
      "type": "select",
      "options": [
        {
          "value": "recruta",
          "label": "Recruta"
        },
        {
          "value": "operador",
          "label": "Operador"
        },
        {
          "value": "agente_especial",
          "label": "Agente especial"
        },
        {
          "value": "oficial",
          "label": "Oficial de operações"
        },
        {
          "value": "elite",
          "label": "Agente de elite"
        }
      ],
      "default": "recruta"
    },
    {
      "id": "prestigio",
      "label": "Pontos de prestígio",
      "type": "number",
      "default": 0,
      "min": 0
    },
    {
      "id": "agi",
      "label": "Agilidade",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 5
    },
    {
      "id": "for",
      "label": "Força",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 5
    },
    {
      "id": "int",
      "label": "Intelecto",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 5
    },
    {
      "id": "pre",
      "label": "Presença",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 5
    },
    {
      "id": "vig",
      "label": "Vigor",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 5
    },
    {
      "id": "pv",
      "label": "Pontos de Vida",
      "type": "resource",
      "color": "red",
      "max": "@classe.pvInicial + @vig + (@nivelNex - 1) * (@classe.pvPorNex + @vig)"
    },
    {
      "id": "pe",
      "label": "Pontos de Esforço",
      "type": "resource",
      "color": "amber",
      "max": "@classe.peInicial + @pre + (@nivelNex - 1) * (@classe.pePorNex + @pre)"
    },
    {
      "id": "san",
      "label": "Sanidade",
      "type": "resource",
      "color": "violet",
      "max": "@classe.sanInicial + (@nivelNex - 1) * @classe.sanPorNex"
    },
    {
      "id": "defesa",
      "label": "Defesa",
      "type": "computed",
      "formula": "10 + @agi"
    },
    {
      "id": "deslocamento",
      "label": "Deslocamento (m)",
      "type": "number",
      "default": 9
    },
    {
      "id": "limitePE",
      "label": "Limite de PE por turno",
      "type": "computed",
      "formula": "@nivelNex"
    },
    {
      "id": "dtRitual",
      "label": "DT de rituais",
      "type": "computed",
      "formula": "10 + @limitePE + @pre"
    },
    {
      "id": "carga",
      "label": "Carga (espaços)",
      "type": "computed",
      "formula": "sum(@itens.espacos * @itens.quantidade)"
    },
    {
      "id": "capacidade",
      "label": "Capacidade (espaços)",
      "type": "computed",
      "formula": "@for == 0 ? 2 : 5 * @for"
    },
    {
      "id": "aparencia",
      "label": "Aparência",
      "type": "longtext"
    },
    {
      "id": "historia",
      "label": "História",
      "type": "longtext"
    },
    {
      "id": "retrato",
      "label": "Retrato",
      "type": "image"
    },
    {
      "id": "anotacoes",
      "label": "Anotações",
      "type": "longtext"
    }
  ],
